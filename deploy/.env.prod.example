# Production environment for the EC2 server -> /opt/smartjourney/.env
# Copy this file there, fill every value, then `chmod 600 .env`.
# NEVER commit the filled-in file. Generate secrets with:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32     (passwords, tokens)
#   openssl rand -base64 32                                (SETTINGS_ENCRYPTION_KEY)
# Full walkthrough: deploy/MANUAL_SETUP.md (section 4).

# ---- Where things live ----------------------------------------------------
# The server's static IP with dashes: 13.233.10.20 -> 13-233-10-20
IP_DASHED=
# Let's Encrypt expiry notices
ACME_EMAIL=
# The Vercel production URL, exactly, no trailing slash
FRONTEND_URL=https://aismartjourney.vercel.app

# ---- Application database -------------------------------------------------
POSTGRES_USER=smartjourney
POSTGRES_DB=smartjourney
POSTGRES_PASSWORD=

# ---- Keycloak ---------------------------------------------------------------
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=
# Admin console login (https://auth.<ip>.sslip.io/admin)
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
# The web app's client secret. Vercel's KEYCLOAK_CLIENT_SECRET must equal this.
KEYCLOAK_WEB_CLIENT_SECRET=
# The NestJS service-account client's secret. Generate it now: Keycloak creates
# the client with this value on first import and NestJS uses it to call
# Keycloak's admin API.
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=smartjourney-backend
KEYCLOAK_AUDIENCE=smartjourney-api
# Google sign-in (same OAuth client as local; add the production redirect URI)
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
# Password-reset / verification email (Gmail: use a 16-character app password)
KC_SMTP_HOST=smtp.gmail.com
KC_SMTP_PORT=587
KC_SMTP_AUTH=true
KC_SMTP_STARTTLS=true
KC_SMTP_SSL=false
KC_SMTP_USER=
KC_SMTP_PASSWORD=
KC_SMTP_FROM=
KC_SMTP_FROM_DISPLAY_NAME=SmartJourney

# ---- Secrets shared by NestJS and the AI backend ----------------------------
# Encrypts API keys saved in Admin > AI models. Changing it makes saved keys unreadable.
SETTINGS_ENCRYPTION_KEY=
# NestJS -> AI backend /internal/llm/* shared secret
INTERNAL_API_TOKEN=

# ---- AI backend: providers and data sources ---------------------------------
# Fallback order; Admin > AI models overrides it at runtime.
LLM_PROVIDER_CHAIN=gemini:gemini-3.5-flash-lite,gemini:gemini-3.6-flash,anthropic:claude-haiku-4-5,groq:openai/gpt-oss-120b
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENWEATHER_API_KEY=
ORS_API_KEY=
BOOKING_RAPIDAPI_KEY=
BOOKING_RAPIDAPI_HOST=booking-com15.p.rapidapi.com
TICKETMASTER_API_KEY=
USD_LKR_RATE=310
ENABLE_RAG=false

# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# ===== Database (docker-compose reads these) =====
POSTGRES_USER=smartjourney
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=smartjourney
POSTGRES_PORT=5432

# Used by NestJS/Prisma and by the AI backend (same database, see
# backend/docs/BACKEND_PLAN.md §2 for the table ownership split).
DATABASE_URL=postgresql://smartjourney:change_me_locally@localhost:5432/smartjourney?schema=public

# ===== Auth =====
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ===== Google SIGN-IN (identity only) =====
# Distinct from the AI backend's GOOGLE_CALENDAR_* credentials, which handle
# Calendar free/busy consent. Different scopes, different redirect URI.
# See backend/docs/BACKEND_PLAN.md §2.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ===== AI backend =====
AI_BACKEND_URL=http://localhost:8000
AI_BACKEND_TIMEOUT_MS=120000

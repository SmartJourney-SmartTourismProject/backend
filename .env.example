# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# NestJS listens here. The web frontend takes 3000, so the API uses 3001.
PORT=3001

# ===== Database (docker-compose reads these) =====
POSTGRES_USER=smartjourney
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=smartjourney
POSTGRES_PORT=5432

# Used by NestJS/Prisma and by the AI backend (same database).
DATABASE_URL=postgresql://smartjourney:change_me_locally@localhost:5432/smartjourney?schema=public

# ===== Auth (Keycloak) =====
# NestJS issues no tokens itself - it verifies Keycloak's RS256 access tokens
# against ${KEYCLOAK_ISSUER}/protocol/openid-connect/certs (src/auth/).
KEYCLOAK_ISSUER=http://localhost:8081/realms/smartjourney
# `aud` the token must carry - added by the "smartjourney-api audience" mapper
# on the smartjourney-web client (keycloak/realm-export.json).
KEYCLOAK_AUDIENCE=smartjourney-api

# Service account the admin endpoints use to manage users in Keycloak (change
# a role, enable/disable an account). Realm settings -> Clients ->
# smartjourney-backend -> Credentials. Its service-account user needs the
# realm-management roles view-users, manage-users and view-realm - a fresh
# realm import does NOT restore those, see keycloak/README.md.
KEYCLOAK_ADMIN_CLIENT_ID=smartjourney-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ===== Keycloak (docker-compose reads these) =====
# Keycloak's own Postgres - separate from the app DB above.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me_locally
KEYCLOAK_DB_NAME=keycloak

# Google SIGN-IN identity provider, configured inside Keycloak (realm
# smartjourney -> Identity providers -> google). Create a *Web application*
# OAuth client in Google Cloud Console with redirect URI
#   http://localhost:8081/realms/smartjourney/broker/google/endpoint
# Distinct from the AI backend's GOOGLE_CALENDAR_* credentials, which handle
# Calendar free/busy consent. Different scopes, different redirect URI.
# See backend/docs/BACKEND_PLAN.md §2.
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# Secret for the confidential `smartjourney-web` OIDC client. Only used on a
# fresh import (existing realms keep whatever the admin console has). Must
# match KEYCLOAK_CLIENT_SECRET in frontend-web/.env.local.
KEYCLOAK_WEB_CLIENT_SECRET=

# ===== Keycloak outgoing mail (forgot-password, email verification) =====
# Defaults target the mailpit container (docker-compose) - inbox at
# http://localhost:8025. For a real provider, e.g. Gmail with an app password:
#   KC_SMTP_HOST=smtp.gmail.com  KC_SMTP_PORT=587  KC_SMTP_AUTH=true
#   KC_SMTP_STARTTLS=true  KC_SMTP_USER=you@gmail.com  KC_SMTP_PASSWORD=<app password>
#   KC_SMTP_FROM=you@gmail.com
# Only read on a fresh realm import; for an existing realm change
# Realm settings -> Email in the admin console (then keycloak/export-realm.sh).
KC_SMTP_HOST=mailpit
KC_SMTP_PORT=1025
KC_SMTP_FROM=noreply@smartjourney.local
KC_SMTP_FROM_DISPLAY_NAME=SmartJourney
KC_SMTP_AUTH=false
KC_SMTP_USER=
KC_SMTP_PASSWORD=
KC_SMTP_STARTTLS=false
KC_SMTP_SSL=false

# ===== AI backend =====
# Origin(s) allowed by CORS (comma-separated), and, in production, the origin
# Keycloak's smartjourney-web client accepts redirects to. Never a wildcard.
FRONTEND_URL=http://localhost:3000
AI_BACKEND_URL=http://localhost:8000
AI_BACKEND_TIMEOUT_MS=120000

# --- Admin > AI models ---
# Encrypts provider API keys saved in the admin panel (32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be identical in backend/.env and ai-backend/.env.
SETTINGS_ENCRYPTION_KEY=
# Shared secret NestJS sends to the AI backend's /internal/llm/* routes (same in both .env files).
INTERNAL_API_TOKEN=
